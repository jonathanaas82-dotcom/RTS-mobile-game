{
  "name": "godforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mobile-first mythology RTS (TypeScript + Phaser 3).",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "e2e": "node scripts/e2e-mobile.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "balance": "vitest run --config vitest.balance.config.ts --reporter=verbose"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "playwright-core": "1.56.1",
    "prettier": "^3.9.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  }
}
